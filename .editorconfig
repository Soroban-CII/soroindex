# EditorConfig — https://editorconfig.org
# Settings match the existing formatting conventions in this repository.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Go source and Makefiles use tabs.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# YAML and JSON use two-space indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# Markdown: preserve trailing whitespace (two spaces = line break).
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
